<schema targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/sp/GetCustomerDBAdapter"
        xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:db="http://xmlns.oracle.com/pcbpel/adapter/db/sp/GetCustomerDBAdapter" elementFormDefault="qualified">
  <element name="InputParameters">
    <complexType>
      <sequence>
        <element name="P_CUSTOMER_ID" type="decimal" db:index="1" db:type="NUMBER" minOccurs="0" nillable="true"/>
      </sequence>
    </complexType>
  </element>
  <element name="OutputParameters">
    <complexType>
      <sequence>
        <element name="P_OUT_CUSTOMER_ID" type="decimal" db:index="2" db:type="NUMBER" minOccurs="0" nillable="true"/>
        <element name="P_FIRST_NAME" type="string" db:index="3" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
        <element name="P_LAST_NAME" type="string" db:index="4" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
        <element name="P_EMAIL" type="string" db:index="5" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
      </sequence>
    </complexType>
  </element>
</schema>
